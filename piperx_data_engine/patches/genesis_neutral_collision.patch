+def _convex_meshes_overlap(mesh_a: trimesh.Trimesh, mesh_b: trimesh.Trimesh) -> bool:
+    """Confirm a neutral-pose voxel overlap using the convex meshes' face planes.
+
+    Coarse voxels can bridge a real clearance and permanently disable a valid
+    self-collision pair. The largest ball inside both convex polyhedra has a
+    positive radius only when their interiors overlap. Center and scale the
+    problem so the tolerance does not depend on world position or asset units.
+    The caller has already shrunk both meshes to allow touching joint surfaces.
+    """
+    bounds = np.stack((mesh_a.bounds, mesh_b.bounds))
+    lower, upper = bounds[:, 0].min(axis=0), bounds[:, 1].max(axis=0)
+    scale = float(np.max(upper - lower))
+    if scale == 0.0:
+        return False
+    center = (lower + upper) / 2.0
+    normals = np.concatenate((mesh_a.face_normals, mesh_b.face_normals))
+    points = np.concatenate((mesh_a.triangles[:, 0], mesh_b.triangles[:, 0]))
+    offsets = np.einsum("ij,ij->i", normals, (points - center) / scale)
+    result = linprog(
+        c=(0.0, 0.0, 0.0, -1.0),
+        A_ub=np.column_stack((normals, np.ones(len(normals)))),
+        b_ub=offsets,
+        bounds=[(None, None)] * 4,
+        method="highs",
+    )
+    if not result.success:
+        raise RuntimeError(f"Could not confirm neutral convex-mesh overlap: {result.message}")
+    return bool(result.x[3] > 1e-9)
+
+
