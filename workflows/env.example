# Copy this file to workflows/local.env. common.sh loads that file automatically.
# Only the Python interpreter paths should need editing after the two Drive
# folders have been copied into data/ and ckpts/.

export PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export DATA_ROOT="${DATA_ROOT:-${PROJECT_ROOT}/data}"
export CHECKPOINT_ROOT="${CHECKPOINT_ROOT:-${PROJECT_ROOT}/ckpts}"

export DATA_PYTHON="${DATA_PYTHON:-/absolute/path/to/the/genesis/environment/bin/python}"
export PIPERX_PYTHON="${PIPERX_PYTHON:-${DATA_PYTHON}}"
export RLINF_PYTHON="${RLINF_PYTHON:-${PROJECT_ROOT}/third_party/RLinf/.venv/bin/python}"
export OPENPI_DATA_HOME="${OPENPI_DATA_HOME:-${CHECKPOINT_ROOT}/openpi_cache}"

export BASE_PI05="${BASE_PI05:-${CHECKPOINT_ROOT}/pi05_base_official_openpi_rlinf}"
export NORM_STATS="${NORM_STATS:-${BASE_PI05}/piperx_five_tasks_2views/norm_stats.json}"

export DEMO_RAW="${DEMO_RAW:-${DATA_ROOT}/all6_100_20260920_223136_raw}"
export DEMO_DATASET="${DEMO_DATASET:-${DATA_ROOT}/all6_100_20260920_223136_lerobot}"
# An explicitly empty value selects only DEMO_DATASET when collecting from scratch.
export SFT_SECOND_DATASET="${SFT_SECOND_DATASET-${DATA_ROOT}/cylinder_rear_50_20260921_0922_lerobot}"
export CALIBRATION="${CALIBRATION:-${DATA_ROOT}/cylinder_rear_50_20260921_0922_raw/cameras.json}"
export SFT_POLICY_CHECKPOINT="${SFT_POLICY_CHECKPOINT:-${CHECKPOINT_ROOT}/finetune_with_collectedD_ckpt}"

export SOURCE_ROLLOUT_ROOT="${SOURCE_ROLLOUT_ROOT:-${DATA_ROOT}/pi05_policy_rollouts_300_raw}"
export CORRECTION_RAW="${CORRECTION_RAW:-${DATA_ROOT}/pi05_ik_corrections_35_fixed_20260923_204117_raw}"
export FAILURE_DATASET="${FAILURE_DATASET:-${DATA_ROOT}/pi05_policy_failures_73_lerobot}"
export POSITIVE_DATASET="${POSITIVE_DATASET:-${DATA_ROOT}/pi05_positive_227plus26_lerobot}"
export NEW_ROLLOUT_DATASET="${NEW_ROLLOUT_DATASET:-${DATA_ROOT}/piperx_advantage_rollout_60_adv3000_seed30000_lerobot}"

export VALUE_CHECKPOINT="${VALUE_CHECKPOINT:-${CHECKPOINT_ROOT}/recap_vlm_advantage_indicator_ckpt/checkpoints/step_003000/pi05_value.pt}"
export GLOBAL_RETURN_MIN="${GLOBAL_RETURN_MIN:--1499.0}"
export POSITIVE_POLICY_CHECKPOINT="${POSITIVE_POLICY_CHECKPOINT:-${CHECKPOINT_ROOT}/finetune_vla_advantage_TRUE_ckpt/checkpoints/global_step_3000/actor}"
export FINAL_POLICY_CHECKPOINT="${FINAL_POLICY_CHECKPOINT:-${CHECKPOINT_ROOT}/final_stage_finetune_ckpt/checkpoints/global_step_5000/actor}"
