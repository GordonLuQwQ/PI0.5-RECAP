paths:
  pi05_checkpoint: "${SFT_POLICY_CHECKPOINT}"
  value_checkpoint: "${VALUE_CHECKPOINT}"
  initial_policy_checkpoint: "${POSITIVE_POLICY_CHECKPOINT}"
  norm_stats: "${NORM_STATS}"
  output_dir: "${FINAL_POLICY_OUTPUT}"
  label_report: "${VALUE_LABEL_REPORT}"

data:
  sources:
    - name: demonstrations_600
      path: "${DEMO_DATASET}"
      returns_type: sft
      expected_episodes: ${DEMO_EPISODES}
    - name: second_rollout_successes_227
      path: "${POSITIVE_DATASET}"
      returns_type: sft
      expected_episodes: ${POLICY_SUCCESS_EPISODES}
      episode_start: 0
      episode_stop: ${POLICY_SUCCESS_EPISODES}
    - name: second_rollout_failures_73
      path: "${FAILURE_DATASET}"
      returns_type: rollout
      expected_episodes: ${FAILURE_EPISODES}
    - name: new_rollouts_60
      path: "${NEW_ROLLOUT_DATASET}"
      returns_type: rollout
      expected_episodes: ${NEW_ROLLOUT_EPISODES}
  expected_total_episodes: ${TOTAL_EPISODES}
  returns_tag: piperx_value_conditioned_all_data
  advantage_tag: piperx_value_conditioned_all_data
  cameras: [third_person, wrist]
  camera_keys:
    third_person: observation.images.image
    wrist: observation.images.image2
  state_key: observation.state
  num_workers: ${POLICY_NUM_WORKERS}
  video_tolerance_s: 0.03
  video_cache_size: 32
  prompt_suffix: "\nAdvantage: positive"

reward:
  step_reward: -1.0
  success_terminal_reward: 0.0
  failure_terminal_reward: -300.0
  gamma: 1.0

normalization:
  return_min: ${GLOBAL_RETURN_MIN}
  return_max: 0.0

value_model:
  pooling: mean_token
  hidden_size: 2048
  head_hidden_size: 1024
  dropout: 0.0
  num_bins: 201
  v_min: -1.0
  v_max: 0.0

advantage:
  lookahead_steps: 10
  discount_next_value: true
  positive_fraction: ${ADVANTAGE_POSITIVE_FRACTION}
  force_sft_positive: true

inference:
  device: cuda
  batch_size: ${VALUE_INFERENCE_BATCH_SIZE}
  num_workers: ${VALUE_INFERENCE_WORKERS}
  pin_memory: true
  checkpoint_every_batches: 10

advantage_conditioning:
  mode: positive_only
  unconditional_probability: 0.0

model:
  model_type: openpi_rlinf
  precision: fp32
  pi05: true
  is_lora: true
  lora_rank: 32
  use_proprio: true
  num_action_chunks: 50
  action_dim: 7
  num_steps: 10
  add_value_head: false
  openpi:
    task: sft
    config_name: pi05_piperx
    action_horizon: 50
    action_chunk: 50
    action_env_dim: 7
    model_action_dim: 32
    max_token_len: 200
    discrete_state_input: true
    paligemma_variant: gemma_2b_lora
    action_expert_variant: gemma_300m_lora
    num_images_in_input: 2
    lora_train_vision: false
    lora_train_action_projections: true
  openpi_data:
    norm_stats_path: "${NORM_STATS}"

training:
  seed: 42
  device: cuda
  batch_size: ${POLICY_BATCH_SIZE}
  max_steps: ${FINAL_POLICY_STEPS}
  learning_rate: 2.5e-5
  adam_beta1: 0.9
  adam_beta2: 0.95
  adam_eps: 1.0e-8
  weight_decay: 1.0e-10
  grad_clip_norm: 1.0
  warmup_steps: ${POLICY_WARMUP_STEPS}
  min_learning_rate: 2.5e-6
  log_every: 10
  save_only_final: true
